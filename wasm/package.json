{
  "name": "ladder-rs-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for the ladder-rs matchmaking library",
  "main": "pkg/ladder_rs_wasm.js",
  "types": "pkg/ladder_rs_wasm.d.ts",
  "files": [
    "pkg/**/*"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:dev": "wasm-pack build --target web --out-dir pkg --dev",
    "build:release": "wasm-pack build --target web --out-dir pkg --release",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "clean": "rm -rf pkg pkg-node pkg-bundler target",
    "test": "wasm-pack test --headless --firefox --chrome",
    "test:node": "wasm-pack test --node",
    "lint": "cargo clippy --target wasm32-unknown-unknown -- -D warnings",
    "fmt": "cargo fmt",
    "check": "cargo check --target wasm32-unknown-unknown",
    "prepublishOnly": "npm run build:release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerns-ai-lab/ladder-rs.git"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "matchmaking",
    "rating",
    "elo",
    "glicko",
    "trueskill",
    "javascript",
    "typescript"
  ],
  "author": "Kerns AI Lab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kerns-ai-lab/ladder-rs/issues"
  },
  "homepage": "https://github.com/kerns-ai-lab/ladder-rs#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}