{
  "name": "ladder-rs-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for the ladder-rs matchmaking library - optimized for web, Node.js, and bundler environments",
  "main": "pkg/ladder_rs_wasm.js",
  "types": "pkg/ladder_rs_wasm.d.ts",
  "files": [
    "pkg/**/*",
    "pkg-node/**/*",
    "pkg-bundler/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "./build.sh --release --target web",
    "build:dev": "./build.sh --dev --target web",
    "build:release": "./build.sh --release --target web",
    "build:all": "./build.sh --release --all-targets",
    "build:all-parallel": "./build.sh --release --all-targets --parallel",
    "build:node": "./build.sh --release --target nodejs",
    "build:bundler": "./build.sh --release --target bundler",
    "build:size-check": "./build.sh --release --target web --verbose",
    "dev": "./scripts/dev.sh --build-only --debug --verbose",
    "dev:watch": "./scripts/dev.sh --watch --debug --verbose",
    "dev:serve": "./scripts/dev.sh --serve --hot-reload --port 3000",
    "dev:all": "./scripts/dev.sh --watch --serve --hot-reload --debug --verbose",
    "dev:watch:build": "./scripts/dev.sh --watch --build-only",
    "dev:watch:files": "./scripts/watch.sh --dirs src tests types --extensions rs toml json",
    "dev:hot-reload": "./scripts/serve.sh --hot-reload --port 3000",
    "dev:debug": "./scripts/dev.sh --debug --verbose --show-env",
    "dev:perf": "./scripts/dev.sh --performance-monitoring --build-only",
    "clean": "rm -rf pkg pkg-node pkg-bundler target .wasm-pack-* .dev_server.pid .watch.pid .hot_reload.pid",
    "clean:dev": "./scripts/dev.sh --cleanup",
    "test": "wasm-pack test --headless --firefox --chrome",
    "test:node": "wasm-pack test --node",
    "test:structure": "cargo test --test package_structure_validation",
    "test:package-json": "cargo test --test package_json_configuration_tests",
    "test:dev-scripts": "cargo test --test development_build_scripts_tests",
    "test:all": "npm run test:structure && npm run test:package-json && npm run test && npm run test:node",
    "lint": "cargo clippy --target wasm32-unknown-unknown -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt -- --check",
    "check": "cargo check --target wasm32-unknown-unknown",
    "check:all": "npm run fmt:check && npm run lint && npm run check",
    "validate": "npm run test:structure && npm run test:package-json && npm run size-report",
    "verify": "npm run check:all && npm run test:all && npm run build:size-check",
    "watch": "npm run dev:watch",
    "serve": "npm run dev:serve",
    "size-report": "./build.sh --release --all-targets && echo '=== Bundle Size Report ===' && find . -name '*.wasm' -exec ls -lh {} \\;",
    "prepublishOnly": "npm run clean && npm run verify && npm run build:all",
    "postbuild": "echo 'Build complete! Generated files:' && ls -la pkg/ 2>/dev/null || echo 'No pkg/ directory found'",
    "postinstall": "echo 'ladder-rs-wasm installed successfully! Run \"npm run dev\" to start development.'",
    "pretest": "npm run build:dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerns-ai-lab/ladder-rs.git",
    "directory": "wasm"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "matchmaking",
    "rating",
    "elo",
    "glicko",
    "glicko2",
    "trueskill",
    "javascript",
    "typescript",
    "ladder",
    "ranking",
    "skillrating",
    "mmr",
    "competitive-gaming"
  ],
  "author": "Kerns AI Lab <contact@kerns-ai-lab.com>",
  "contributors": [
    {
      "name": "Kerns AI Lab Team",
      "url": "https://github.com/kerns-ai-lab"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kerns-ai-lab/ladder-rs/issues",
    "email": "bugs@kerns-ai-lab.com"
  },
  "homepage": "https://github.com/kerns-ai-lab/ladder-rs#readme",
  "documentation": "https://github.com/kerns-ai-lab/ladder-rs/tree/main/wasm/README.md",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "concurrently": "^8.0.0",
    "rimraf": "^5.0.0",
    "npm-run-all": "^4.1.5"
  },
  "peerDependencies": {
    "wasm-pack": "^0.12.0"
  },
  "peerDependenciesMeta": {
    "wasm-pack": {
      "optional": false,
      "note": "Required for building from source"
    }
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    ".": {
      "types": "./pkg/ladder_rs_wasm.d.ts",
      "browser": "./pkg/ladder_rs_wasm.js",
      "import": {
        "node": "./pkg-node/ladder_rs_wasm.js",
        "default": "./pkg/ladder_rs_wasm.js"
      },
      "require": "./pkg-node/ladder_rs_wasm.js",
      "default": "./pkg/ladder_rs_wasm.js"
    },
    "./web": {
      "types": "./pkg/ladder_rs_wasm.d.ts",
      "import": "./pkg/ladder_rs_wasm.js",
      "default": "./pkg/ladder_rs_wasm.js"
    },
    "./node": {
      "types": "./pkg-node/ladder_rs_wasm.d.ts",
      "import": "./pkg-node/ladder_rs_wasm.js",
      "require": "./pkg-node/ladder_rs_wasm.js",
      "default": "./pkg-node/ladder_rs_wasm.js"
    },
    "./bundler": {
      "types": "./pkg-bundler/ladder_rs_wasm.d.ts",
      "import": "./pkg-bundler/ladder_rs_wasm.js",
      "default": "./pkg-bundler/ladder_rs_wasm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "workspaces": {
    "nohoist": [
      "**/wasm-pack",
      "**/wasm-pack/**"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}